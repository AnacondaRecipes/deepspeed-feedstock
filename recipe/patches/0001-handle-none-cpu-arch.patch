From 28f78b92ab3883d1cab560d06f9fbba0d58a18af Mon Sep 17 00:00:00 2001
From: xkong-anaconda <xkong@anaconda.com>
Date: Sat, 31 Oct 2026 15:24:15 -0500
Subject: [PATCH] Handle None cpu_info['arch'] from py-cpuinfo on aarch64

py-cpuinfo's get_cpu_info() returns arch=None on some aarch64 CI
environments, and the lscpu fallback (_backup_cpuinfo) leaves arch=None
for unrecognised machines. cpu_arch() calls .startswith('PPC_') on the
value directly and crashes. Upstream 0.19.9 already guards the riscv64
and simd_width() checks with (cpu_info['arch'] or ''); apply the same
guard to the PPC_ check so the default '-march=native' is returned.

The sdist ships two identical copies of builder.py (op_builder/ for the
build, deepspeed/ops/op_builder/ for runtime JIT); patch both.
---
 deepspeed/ops/op_builder/builder.py | 2 +-
 op_builder/builder.py               | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/deepspeed/ops/op_builder/builder.py b/deepspeed/ops/op_builder/builder.py
index 58350ba..c35bf5f 100644
--- a/deepspeed/ops/op_builder/builder.py
+++ b/deepspeed/ops/op_builder/builder.py
@@ -442,7 +442,7 @@ class OpBuilder(ABC):
             if cpu_info is None:
                 return "-march=native"
 
-        if cpu_info['arch'].startswith('PPC_'):
+        if (cpu_info['arch'] or '').startswith('PPC_'):
             # gcc does not provide -march on PowerPC, use -mcpu instead
             return '-mcpu=native'
         elif (cpu_info['arch'] or '').lower().replace('_', '').startswith('riscv64'):
diff --git a/op_builder/builder.py b/op_builder/builder.py
index 58350ba..c35bf5f 100644
--- a/op_builder/builder.py
+++ b/op_builder/builder.py
@@ -442,7 +442,7 @@ class OpBuilder(ABC):
             if cpu_info is None:
                 return "-march=native"
 
-        if cpu_info['arch'].startswith('PPC_'):
+        if (cpu_info['arch'] or '').startswith('PPC_'):
             # gcc does not provide -march on PowerPC, use -mcpu instead
             return '-mcpu=native'
         elif (cpu_info['arch'] or '').lower().replace('_', '').startswith('riscv64'):
